{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satinlore-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "satinlore-waitlist",
      "database_id": "9bfa0082-f4bb-4625-97f0-254f0e469b83",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://satinlore.com",
    "SES_REGION": "eu-north-1",
    "SES_FROM_EMAIL": "Satinlore <team@satinlore.com>",
    "FOUNDER_NOTIFICATION_EMAIL": "team@satinlore.com",
    "EMAIL_ENABLED": "false",
    "WELCOME_EMAIL_ENABLED": "false",
    "ADMIN_EMAIL": "team@satinlore.com",
    "ACCESS_TEAM_DOMAIN": "satinlore.cloudflareaccess.com",
    "ACCESS_AUD": "1ea771adcb502a7ad2e7ed04f5074058d918ee1cef26853fc70be91483ba9346"
  }
}
